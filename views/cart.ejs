<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shopping Cart</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/darkmode.css">
  <script src="/js/darkmode.js"></script>
  <style>
    .cart-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    .cart-item-card {
      border: 1px solid #ddd;
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
      display: flex;
      gap: 15px;
      align-items: center;
    }

    body.dark-mode .cart-item-card {
      border-color: #444;
      background-color: #2d2d2d;
    }

    .cart-item-image {
      width: 100px;
      height: 100px;
      object-fit: cover;
      border-radius: 5px;
    }

    .cart-item-details {
      flex: 1;
    }

    .cart-item-name {
      font-size: 1.1rem;
      font-weight: bold;
      margin-bottom: 10px;
    }

    .cart-summary-box {
      background-color: #f8f9fa;
      padding: 20px;
      border-radius: 8px;
      position: sticky;
      top: 20px;
    }

    body.dark-mode .cart-summary-box {
      background-color: #2d2d2d;
    }

    .cart-summary-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 12px;
      font-size: 1rem;
    }

    .cart-summary-total {
      font-size: 1.5rem;
      font-weight: bold;
      border-top: 2px solid #ddd;
      padding-top: 12px;
      margin-top: 12px;
      color: #28a745;
    }

    body.dark-mode .cart-summary-total {
      border-top-color: #444;
      color: #66bb6a;
    }

    .empty-cart-message {
      text-align: center;
      padding: 60px 20px;
    }

    .empty-cart-icon {
      font-size: 4rem;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Supermarket App</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="collapsibleNavbar">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <a class="nav-link" href="/shopping">Shop</a>
            </li> 
            <li class="nav-item">
              <a class="nav-link" href="/logout">Logout</a>
            </li>
            <li class="nav-item">
              <button class="btn btn-sm dark-mode-toggle ms-2" onclick="toggleDarkMode()">🌙 Dark Mode</button>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Cart Content -->
    <div class="container cart-container mt-4 mb-5">
      <div class="row mb-4">
        <div class="col">
          <h1>Shopping Cart</h1>
          <p class="text-muted">Review your items before checkout</p>
        </div>
      </div>

      <!-- Flash Messages -->
      <% if (success && success.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= success[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>
      <% if (error && error.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= error[0] %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
      <% } %>

      <% if (cart && cart.length > 0) { %>
        <!-- Cart Items -->
        <div class="row">
          <div class="col-lg-8">
            <h3 class="mb-3">Items in Cart (<%= cart.length %>)</h3>
            
            <% cart.forEach(item => { %>
              <div class="cart-item-card">
                <img src="/images/<%= item.image %>" alt="<%= item.productName %>" class="cart-item-image">
                
                <div class="cart-item-details">
                  <div class="cart-item-name"><%= item.productName %></div>
                  <div class="row g-2 text-muted small">
                    <div class="col-auto">
                      <strong>Price:</strong> $<%= parseFloat(item.price).toFixed(2) %>
                    </div>
                    <div class="col-auto">
                      <strong>Quantity:</strong> <span class="badge bg-info"><%= item.quantity %></span>
                    </div>
                    <div class="col-auto">
                      <strong>Subtotal:</strong> $<%= (parseFloat(item.price) * item.quantity).toFixed(2) %>
                    </div>
                  </div>
                </div>

                <div>
                  <form method="POST" action="/remove-from-cart/<%= item.id %>" style="display: inline;">
                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Remove this item?')">
                      Remove
                    </button>
                  </form>
                </div>
              </div>
            <% }); %>
          </div>

          <!-- Cart Summary Sidebar -->
          <div class="col-lg-4">
            <div class="cart-summary-box">
              <h4 class="mb-4">Order Summary</h4>
              
              <% 
                let subtotal = 0;
                let tax = 0;
                cart.forEach(item => {
                  subtotal += parseFloat(item.price) * item.quantity;
                });
                tax = subtotal * 0.1; // 10% tax for example
                let total = subtotal + tax;
              %>

              <div class="cart-summary-row">
                <span>Subtotal:</span>
                <span>$<%= subtotal.toFixed(2) %></span>
              </div>

              <div class="cart-summary-row">
                <span>Tax (10%):</span>
                <span>$<%= tax.toFixed(2) %></span>
              </div>

              <div class="cart-summary-total">
                <div class="cart-summary-row">
                  <span>Total:</span>
                  <span>$<%= total.toFixed(2) %></span>
                </div>
              </div>

              <div class="d-grid gap-2 mt-4">
                <a href="/checkout" class="btn btn-success btn-lg">
                  Proceed to Checkout
                </a>
                <a href="/shopping" class="btn btn-secondary">
                  Continue Shopping
                </a>
              </div>

              <div class="mt-3 p-3 alert alert-info small">
                <i class="bi bi-info-circle"></i>
                Free shipping on orders over $50
              </div>
            </div>
          </div>
        </div>

      <% } else { %>
        <!-- Empty Cart Message -->
        <div class="empty-cart-message">
          <div class="empty-cart-icon">🛒</div>
          <h2>Your Cart is Empty</h2>
          <p class="text-muted mb-4">Looks like you haven't added any items to your cart yet.</p>
          <a href="/shopping" class="btn btn-primary btn-lg">Start Shopping</a>
        </div>
      <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
