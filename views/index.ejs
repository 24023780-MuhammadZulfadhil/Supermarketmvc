<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supermarket App - Welcome</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/darkmode.css">
    <script src="/js/darkmode.js"></script>
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 100px 20px;
            text-align: center;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        body.dark-mode .hero-section {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        }

        .hero-content h1 {
            font-size: 3.5rem;
            font-weight: bold;
            margin-bottom: 20px;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3);
        }

        .hero-content p {
            font-size: 1.3rem;
            margin-bottom: 40px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.3);
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 30px;
        }

        .hero-buttons a {
            padding: 14px 35px;
            font-size: 1.1rem;
            border-radius: 50px;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
        }

        .hero-buttons .btn-primary {
            background-color: #007bff;
            border-color: #007bff;
        }

        .hero-buttons .btn-primary:hover {
            background-color: #0056b3;
            border-color: #0056b3;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0, 123, 255, 0.4);
        }

        .hero-buttons .btn-success {
            background-color: #28a745;
            border-color: #28a745;
        }

        .hero-buttons .btn-success:hover {
            background-color: #218838;
            border-color: #218838;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(40, 167, 69, 0.4);
        }

        .dark-mode-toggle-hero {
            position: absolute;
            top: 20px;
            right: 20px;
            z-index: 10;
        }

        .user-badge {
            background-color: rgba(255, 255, 255, 0.2);
            padding: 10px 20px;
            border-radius: 20px;
            margin-bottom: 30px;
            display: inline-block;
            font-size: 1.1rem;
        }

        .features-section {
            padding: 60px 20px;
            background-color: #f8f9fa;
        }

        body.dark-mode .features-section {
            background-color: #0d0d0d;
        }

        .feature-card {
            text-align: center;
            padding: 30px;
            margin: 15px 0;
            border-radius: 10px;
            background-color: white;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease;
        }

        body.dark-mode .feature-card {
            background-color: #2d2d2d;
        }

        .feature-card:hover {
            transform: translateY(-5px);
        }

        .feature-icon {
            font-size: 3rem;
            margin-bottom: 15px;
        }

        .feature-card h4 {
            font-weight: 600;
            margin-bottom: 10px;
        }

        .footer {
            background-color: #f8f9fa;
            padding: 30px 20px;
            text-align: center;
            color: #666;
            margin-top: 60px;
        }

        body.dark-mode .footer {
            background-color: #0d0d0d;
            color: #b0b0b0;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold" href="/">🛒 Supermarket App</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <% if (!user) { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/register">Register</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/login">Login</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/shopping">Shop</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/cart">Cart</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/logout">Logout</a>
                        </li>
                    <% } %>
                    <li class="nav-item">
                        <button class="btn btn-sm dark-mode-toggle ms-2" onclick="toggleDarkMode()">🌙 Dark Mode</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Dark Mode Toggle Button (Hero) -->
    <div class="dark-mode-toggle-hero">
        <!-- Toggle is in navbar -->
    </div>

    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-content">
            <% if (user) { %>
                <!-- Logged In User -->
                <div class="user-badge">
                    Welcome back, <strong><%= user.username %></strong>!
                </div>
                <% if (user.role === "admin") { %>
                    <h1>Supermarket Management</h1>
                    <p class="lead">Manage your inventory and products efficiently</p>
                    <div class="hero-buttons">
                        <a href="/inventory" class="btn btn-primary btn-lg">View Inventory</a>
                        <a href="/addProduct" class="btn btn-success btn-lg">Add New Product</a>
                    </div>
                <% } else { %>
                    <h1>Shop with Us Today!</h1>
                    <p class="lead">Browse our wide selection of products</p>
                    <div class="hero-buttons">
                        <a href="/shopping" class="btn btn-success btn-lg">Start Shopping</a>
                        <a href="/cart" class="btn btn-primary btn-lg">View My Cart</a>
                    </div>
                <% } %>
            <% } else { %>
                <!-- Not Logged In -->
                <h1>Welcome to Supermarket</h1>
                <p class="lead">Your one-stop shopping destination</p>
                <p style="font-size: 1.1rem; margin-bottom: 30px;">
                    Discover amazing products at unbeatable prices. 
                    Register or login to start shopping!
                </p>
                <div class="hero-buttons">
                    <a href="/login" class="btn btn-primary btn-lg">Login</a>
                    <a href="/register" class="btn btn-success btn-lg">Create Account</a>
                </div>
            <% } %>
        </div>
    </div>

    <% if (!user) { %>
        <!-- Features Section (Only for non-logged-in users) -->
        <div class="features-section">
            <div class="container">
                <h2 class="text-center mb-5">Why Choose Us?</h2>
                <div class="row">
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">🏪</div>
                            <h4>Wide Selection</h4>
                            <p>Browse through thousands of quality products curated just for you.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">💰</div>
                            <h4>Best Prices</h4>
                            <p>Enjoy competitive pricing and special discounts on popular items.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="feature-card">
                            <div class="feature-icon">🚀</div>
                            <h4>Fast Checkout</h4>
                            <p>Quick and secure payment process with multiple payment options.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Footer -->
    <div class="footer">
        <div class="container">
            <p>&copy; 2024 Supermarket App. All rights reserved.</p>
            <p>
                <% if (!user) { %>
                    <a href="/register">Register</a> | <a href="/login">Login</a>
                <% } else { %>
                    <a href="/shopping">Shop</a> | <a href="/logout">Logout</a>
                <% } %>
            </p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
