<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/darkmode.css">
    <script src="/js/darkmode.js"></script>
    <style>
        .checkout-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .checkout-item {
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 15px;
            display: flex;
            gap: 15px;
            align-items: center;
        }

        body.dark-mode .checkout-item {
            border-color: #444;
            background-color: #2d2d2d;
        }

        .checkout-item-image {
            width: 100px;
            height: 100px;
            object-fit: cover;
            border-radius: 5px;
        }

        .checkout-item-details {
            flex: 1;
        }

        .checkout-item-name {
            font-size: 1.1rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .checkout-item-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            font-size: 0.95rem;
            color: #666;
        }

        body.dark-mode .checkout-item-info {
            color: #b0b0b0;
        }

        .order-summary {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            position: sticky;
            top: 20px;
        }

        body.dark-mode .order-summary {
            background-color: #2d2d2d;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 1rem;
        }

        .summary-total {
            font-size: 1.5rem;
            font-weight: bold;
            border-top: 2px solid #ddd;
            padding-top: 12px;
            margin-top: 12px;
            color: #28a745;
        }

        body.dark-mode .summary-total {
            border-top-color: #444;
            color: #66bb6a;
        }

        .order-details-header {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px 8px 0 0;
            margin-bottom: 0;
        }

        body.dark-mode .order-details-header {
            background-color: #1a1a1a;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Supermarket App</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="collapsibleNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/shopping">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">Cart</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Logout</a>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm dark-mode-toggle ms-2" onclick="toggleDarkMode()">🌙 Dark Mode</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container checkout-container mt-4 mb-5">
        <h1 class="mb-4">Order Confirmation</h1>

        <!-- Alerts -->
        <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <%= success[0] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <%= error[0] %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <div class="row">
            <!-- Checkout Items -->
            <div class="col-lg-8">
                <div class="order-details-header">
                    <h3 class="mb-0">Order Details</h3>
                </div>
                
                <% if (cart && cart.length > 0) { %>
                    <% cart.forEach(item => { %>
                        <div class="checkout-item">
                            <img src="/images/<%= item.image %>" alt="<%= item.productName %>" class="checkout-item-image">
                            <div class="checkout-item-details">
                                <div class="checkout-item-name"><%= item.productName %></div>
                                <div class="checkout-item-info">
                                    <div>
                                        <strong>Unit Price:</strong> $<%= parseFloat(item.price).toFixed(2) %>
                                    </div>
                                    <div>
                                        <strong>Quantity:</strong> <%= item.quantity %>
                                    </div>
                                    <div>
                                        <strong>Subtotal:</strong> $<%= (parseFloat(item.price) * item.quantity).toFixed(2) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="alert alert-warning mt-3">
                        <p class="mb-0">No items in your order</p>
                    </div>
                <% } %>
            </div>

            <!-- Order Summary Sidebar -->
            <div class="col-lg-4">
                <div class="order-summary">
                    <h4 class="mb-4">Order Summary</h4>
                    
                    <% 
                        let subtotal = 0;
                        let taxRate = 0; // 0% tax
                        let tax = 0;
                        if (cart && cart.length > 0) {
                            cart.forEach(item => {
                                subtotal += parseFloat(item.price) * item.quantity;
                            });
                            tax = subtotal * taxRate;
                        }
                        let totalAmount = subtotal + tax;
                    %>

                    <div class="summary-row">
                        <span>Subtotal:</span>
                        <span>$<%= subtotal.toFixed(2) %></span>
                    </div>

                    <% if (taxRate > 0) { %>
                        <div class="summary-row">
                            <span>Tax (<%= (taxRate * 100) %>%):</span>
                            <span>$<%= tax.toFixed(2) %></span>
                        </div>
                    <% } %>

                    <div class="summary-total">
                        <div class="summary-row">
                            <span>Total Amount:</span>
                            <span>$<%= totalAmount.toFixed(2) %></span>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <form action="/process-payment" method="POST">
                            <button type="submit" class="btn btn-success btn-lg w-100" <%= cart && cart.length > 0 ? '' : 'disabled' %>>
                                Process Payment
                            </button>
                        </form>
                    </div>

                    <div class="d-grid gap-2 mt-2">
                        <a href="/cart" class="btn btn-secondary">
                            Back to Cart
                        </a>
                    </div>

                    <div class="mt-3 p-3 alert alert-info small">
                        <strong>✓ Secure Checkout</strong><br>
                        Your payment information is encrypted and secure.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
