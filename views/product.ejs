<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/darkmode.css">
    <script src="/js/darkmode.js"></script>
    <title>Product Details</title>
    <style>
        .product-detail-container {
            max-width: 1000px;
            margin: 0 auto;
        }

        .product-image-section {
            text-align: center;
        }

        .product-image {
            width: 100%;
            max-height: 500px;
            object-fit: cover;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        body.dark-mode .product-image {
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        .product-info-section {
            padding: 30px 0;
        }

        .product-title {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 20px;
            color: #333;
        }

        body.dark-mode .product-title {
            color: #e0e0e0;
        }

        .product-price {
            font-size: 2rem;
            color: #28a745;
            font-weight: bold;
            margin-bottom: 20px;
        }

        body.dark-mode .product-price {
            color: #66bb6a;
        }

        .stock-badge {
            display: inline-block;
            padding: 10px 20px;
            border-radius: 5px;
            font-size: 1.1rem;
            margin-bottom: 20px;
        }

        .product-details {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        body.dark-mode .product-details {
            background-color: #2d2d2d;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid #ddd;
        }

        body.dark-mode .detail-row {
            border-bottom-color: #444;
        }

        .detail-row:last-child {
            border-bottom: none;
        }

        .detail-label {
            font-weight: bold;
            color: #666;
        }

        body.dark-mode .detail-label {
            color: #b0b0b0;
        }

        .add-to-cart-form {
            background-color: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
        }

        body.dark-mode .add-to-cart-form {
            background-color: #2d2d2d;
        }

        .quantity-selector {
            margin-bottom: 15px;
        }

        .quantity-selector label {
            display: block;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .quantity-selector select {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1rem;
        }

        body.dark-mode .quantity-selector select {
            background-color: #1a1a1a;
            color: #e0e0e0;
            border-color: #444;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
            flex-direction: column;
        }

        .action-buttons button,
        .action-buttons a {
            padding: 15px;
            font-size: 1.1rem;
            font-weight: bold;
            border-radius: 5px;
            text-align: center;
            text-decoration: none;
        }

        .back-link {
            display: inline-block;
            margin-bottom: 20px;
            color: #007bff;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }

        body.dark-mode .back-link {
            color: #64b5f6;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-sm bg-dark navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Supermarket App</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#collapsibleNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="collapsibleNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/shopping">Shop</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">Cart</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/logout">Logout</a>
                    </li>
                    <li class="nav-item">
                        <button class="btn btn-sm dark-mode-toggle ms-2" onclick="toggleDarkMode()">🌙 Dark Mode</button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container product-detail-container mt-4 mb-5">
        <!-- Back Link -->
        <a href="/shopping" class="back-link">← Back to Shopping</a>

        <% if (product) { %>
            <div class="row">
                <!-- Product Image -->
                <div class="col-md-6">
                    <div class="product-image-section">
                        <img src="/images/<%= product.image %>" alt="<%= product.productName %>" class="product-image">
                    </div>
                </div>

                <!-- Product Information -->
                <div class="col-md-6">
                    <div class="product-info-section">
                        <!-- Title -->
                        <h1 class="product-title"><%= product.productName %></h1>

                        <!-- Price -->
                        <div class="product-price">
                            $<%= parseFloat(product.price).toFixed(2) %>
                        </div>

                        <!-- Stock Status -->
                        <div>
                            <% if (product.quantity > 0) { %>
                                <span class="stock-badge badge bg-success">
                                    ✓ In Stock (<%= product.quantity %> available)
                                </span>
                            <% } else { %>
                                <span class="stock-badge badge bg-danger">
                                    ✗ Out of Stock
                                </span>
                            <% } %>
                        </div>

                        <!-- Product Details -->
                        <div class="product-details">
                            <div class="detail-row">
                                <span class="detail-label">Product ID:</span>
                                <span>#<%= product.id %></span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Availability:</span>
                                <span>
                                    <% if (product.quantity > 0) { %>
                                        <%= product.quantity %> units available
                                    <% } else { %>
                                        Currently unavailable
                                    <% } %>
                                </span>
                            </div>
                            <div class="detail-row">
                                <span class="detail-label">Unit Price:</span>
                                <span>$<%= parseFloat(product.price).toFixed(2) %></span>
                            </div>
                        </div>

                        <!-- Add to Cart Form -->
                        <% if (product.quantity > 0) { %>
                            <form action="/add-to-cart/<%= product.id %>" method="POST" class="add-to-cart-form">
                                <div class="quantity-selector">
                                    <label for="quantity">Select Quantity:</label>
                                    <select name="quantity" id="quantity" class="form-select" required>
                                        <option value="">-- Choose Quantity --</option>
                                        <% for (let i = 1; i <= product.quantity; i++) { %>
                                            <option value="<%= i %>"><%= i %></option>
                                        <% } %>
                                    </select>
                                </div>

                                <div class="action-buttons">
                                    <button type="submit" class="btn btn-success btn-lg">
                                        🛒 Add to Cart
                                    </button>
                                    <a href="/shopping" class="btn btn-secondary">
                                        Continue Shopping
                                    </a>
                                </div>
                            </form>
                        <% } else { %>
                            <div class="add-to-cart-form">
                                <div class="alert alert-warning mb-0">
                                    This product is currently out of stock.
                                </div>
                                <div class="action-buttons mt-3">
                                    <a href="/shopping" class="btn btn-secondary">
                                        View Other Products
                                    </a>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div class="alert alert-danger">
                <h4>Product Not Found</h4>
                <p>The product you're looking for doesn't exist or has been removed.</p>
                <a href="/shopping" class="btn btn-primary">Back to Shopping</a>
            </div>
        <% } %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
